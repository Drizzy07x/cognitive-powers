{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/semantic_index.py\" session-start",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\semantic_index.py\" session-start",
            "timeout": 150
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/skill_activation.py\" session-start",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\skill_activation.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/skill_router.py\" user-prompt-submit",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\skill_router.py\" user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/selective_hooks.py\" post-tool-use",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\selective_hooks.py\" post-tool-use"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/clean_code_guard.py\" post-tool-use",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\clean_code_guard.py\" post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/hooks/selective_hooks.py\" stop",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\selective_hooks.py\" stop"
          }
        ]
      }
    ]
  }
}
