{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/semantic_index.py",
              "session-start"
            ],
            "timeout": 150
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/skill_router.py",
              "user-prompt-submit"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/selective_hooks.py",
              "post-tool-use"
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/clean_code_guard.py",
              "post-tool-use"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python_executable}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/selective_hooks.py",
              "stop"
            ]
          }
        ]
      }
    ]
  }
}
